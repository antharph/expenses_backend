APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Copy to .env.testing for IDE test runners.
# PHPUnit uses tests/bootstrap.php and phpunit.xml to target expenses_test — never the dev DB.
DB_CONNECTION=mysql
DB_HOST=personal_mysqldb
DB_PORT=3306
DB_DATABASE=expenses_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

APPLE_BUNDLE_ID=com.maiexpenses.app
APPLE_SERVICES_ID=com.maiexpenses.service
